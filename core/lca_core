  reply="$(ask "${MASTER}" "${user_block}")"
  [[ -n "${reply}" ]] || { echo "empty reply; stopping" >&2; break; }

  if [[ "${PARALLEL}" -eq 1 ]]; then
    obs="$(run_parallel "${reply}" 2>/dev/null)"
    case "${obs}" in
      FINAL*) echo "final answer: ${reply}" >&2; _tools_used="${_tools_used}done"; break ;;
      *) obs="$(printf '%s' "${obs}" | sed 's/^FINAL//' | head -c 2500)" ;;
    esac
    _us="${user_block}

[${i}] You: ${reply}
Obs: ${obs}

Next tool(s) (up to 3 independent lines):"
    user_block="${_us}"
    continue
  fi

  tool_line="$(printf '%s\n' "${reply}" | grep -E '^[a-z]+ ' | head -n 1 || true)"
  if [[ -z "${tool_line}" ]]; then
    echo "final answer:" >&2; printf '%s\n' "${reply}"
    _tools_used="${_tools_used}done"; break
