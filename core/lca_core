  [[ "${tool}" == "done" ]] && { echo "done." >&2; break; }
  obs="$(run_tool_smart "${tool_line}" || echo "tool failed")"
  obs="$(printf '%s' "${obs}" | head -c 2500)"
  _us="${user_block}

[${i}] You: ${reply}
Obs: ${obs}

Next tool (ONE line only):"
  user_block="${_us}"
done
