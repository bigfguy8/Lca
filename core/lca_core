run_parallel() {
  local reply="$1"
  local lines n=0 obsall="" t _lp
  _lp="$(mktemp)"
  printf '%s\n' "${reply}" | grep -E '^[a-z]+ ' > "${_lp}" 2>/dev/null || true
  while IFS= read -r t; do
    case "${t}" in
      ls\ *|cat\ *|grep\ *|shell\ *|write\ *|writef\ *)
        n=$(( n + 1 ))
        obsall="${obsall}[${n}] ${t} →
$(run_tool_smart "${t}" || echo "tool failed")

" ;;
      done*)
        rm -f "${_lp}"
        printf 'FINAL\n'
        return 0 ;;
    esac
    (( n >= 3 )) && break
  done < "${_lp}"
  rm -f "${_lp}"
  printf '%s' "${obsall}"
}

i=0; _tools_used=""; _t0="$(date +%s)"
while (( i++ < MAXIT )); do
