#!/usr/bin/env sh
# lca v5 web UI — public (MIT)
#
# A tiny HTTP server that exposes the SAME closed core over localhost.
# Nothing leaves the device. The closed core does all the real work; this
# server just wraps it so you can poke it from a phone browser.
#
#   sh bin/lca-web                start on port 7880
#   sh bin/lca-web stop           kill the saved PID
#   LCA_PORT=9000 sh bin/lca-web  custom port
#
# Endpoints:
#   GET  /          minimal HTML form
#   GET  /status   JSON: {version, tier, gpu, models}
#   GET  /models   one model id per line
#   POST /run      JSON body {prompt, skill?, parallel?, unlimited?}
#
# SECURITY:
#   - Binds to 127.0.0.1 only. No auth (local-only).
#   - The closed core enforces its own SHA256 gate on every call.
#   - The web UI grants nothing the core doesn't already allow.
#
# The server prefers python3 (always present in Termux); falls back to a
# minimal nc loop if python3 is missing. Either way, the closed core does
# all the actual agent work — this is just a thin HTTP shell.

set -eu

if [[ -n "${LCA_HOME:-}" ]]; then :
elif [[ -d "$(dirname "${0}")/../core" ]]; then LCA_HOME="$(cd "$(dirname "${0}")/.." && pwd)"
else LCA_HOME="${HOME}/.lca"
fi
[[ -d "${LCA_HOME}" ]] || { echo "lca-web: project not found (set LCA_HOME)" >&2; exit 1; }

PORT="${LCA_PORT:-7880}"
PIDFILE="${LCA_HOME}/.lca/.web.pid"
mkdir -p "${LCA_HOME}/.lca"

# ---- stop mode -------------------------------------------------------
if [[ "${1:-}" == "stop" ]]; then
  [[ -f "${PIDFILE}" ]] || { echo "no running lca-web"; exit 0; }
  kill "$(cat "${PIDFILE}")" 2>/dev/null || true
  rm -f "${PIDFILE}"
  echo "lca-web stopped"
  exit 0
fi

# ---- python3 server (primary) ---------------------------------------
if command -v python3 >/dev/null 2>&1; then
  echo "$$" > "${PIDFILE}"
  trap 'rm -f "${PIDFILE}"' EXIT
  echo "lca-web v5 on http://127.0.0.1:${PORT}   (python3; stop: sh bin/lca-web stop)"
  exec env LCA_HOME="${LCA_HOME}" python3 - "${PORT}" <<'PY'
import http.server, json, os, re, sys, subprocess

PORT=int(sys.argv[1]); HOME=os.environ["LCA_HOME"]
def read_file(p):
    with open(p) as f: return f.read()
def manifest_ver():
    try: return re.search(r'"version"\s*:\s*"([^"]+)"', read_file(HOME+"/core/manifest.json")).group(1)
    except Exception: return "unknown"
def model_ids():
    try: return re.findall(r'"id"\s*:\s*"([a-z0-9.-]+)"', read_file(HOME+"/core/registry.json"))
    except Exception: return []
def status():
    return json.dumps({"version":manifest_ver(),
                       "tier":os.environ.get("LCA_TIER","free"),
                       "gpu":os.environ.get("LCA_GPU","cpu"),
                       "models":",".join(model_ids())})
def run_once(prompt, skill, par, unl):
    args=[os.path.join(HOME,"bin","lca.sh")]
    if skill: args+=["--skill", skill]
    if par:   args+=["--parallel"]
    if unl:   args+=["--unlimited"]
    args.append(prompt or "")
    r=subprocess.run(args, capture_output=True, text=True, timeout=900)
    return (r.stdout or "") + (("\n--- stderr ---\n"+r.stderr) if r.stderr else "")
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self,*a): pass
    def _send(self, code, body, ctype="text/plain"):
        b=body.encode()
        self.send_response(code); self.send_header("Content-Type",ctype); self.send_header("Content-Length",str(len(b))); self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        p=self.path.split("?")[0]
        if p=="/status":  self._send(200,status(),"application/json")
        elif p=="/models": self._send(200,"\n".join(model_ids()))
        elif p in ("/","/index.html"):
            f=HOME+"/web/index.html"
            self._send(200, read_file(f) if os.path.exists(f) else "no web UI", "text/html")
        else: self._send(404,"not found")
    def do_POST(self):
        if self.path.split("?")[0]!="/run": return self._send(404,"no")
        n=int(self.headers.get("Content-Length","0") or 0)
        try: d=json.loads(self.rfile.read(n).decode() or "{}")
        except Exception: d={}
        out=run_once(d.get("prompt",""), d.get("skill",""), bool(d.get("parallel")), bool(d.get("unlimited")))
        self._send(200, out)
http.server.HTTPServer(("127.0.0.1",PORT),H).serve_forever()
PY
fi

# ---- nc fallback (last resort) -------------------------------------
if command -v nc >/dev/null 2>&1; then
  echo "lca-web v5 on http://127.0.0.1:${PORT}   (nc fallback; no /run support)"
  echo "$$" > "${PIDFILE}"
  # nc -L -p PORT sh -c "handler"  →  spawn a handler per incoming connection
  # Each handler writes its own response; nc -L will keep listening.
  export LCA_HOME
  exec nc -L -s 127.0.0.1 -p "${PORT}" sh -c '
    _req="$(cat | tr -d "\r" | head -n 1)"
    case "${_req}" in
      *GET*\ /status*)
        _v="unknown"
        _v="$(grep -oE "\"version\": *\"[^\"]*\"" "${LCA_HOME}/core/manifest.json" 2>/dev/null | cut -d\" -f4 | head -1 || echo unknown)"
        _m="$(grep -oE "\"id\": *\"[a-z0-9.-]+\"" "${LCA_HOME}/core/registry.json" 2>/dev/null | cut -d\" -f4 | tr "\n" "," | sed "s/,$//")"
        printf "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n"
        printf "{\"version\":\"%s\",\"tier\":\"%s\",\"gpu\":\"%s\",\"models\":\"%s\"}\n" \
          "${_v}" "${LCA_TIER:-free}" "${LCA_GPU:-cpu}" "${_m}"
        ;;
      *GET*\ /models*)
        printf "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\n"
        grep -oE "\"id\": *\"[a-z0-9.-]+\"" "${LCA_HOME}/core/registry.json" 2>/dev/null | cut -d\" -f4 || true
        ;;
      *GET*\ /*)
        printf "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n"
        [[ -f "${LCA_HOME}/web/index.html" ]] && cat "${LCA_HOME}/web/index.html" || echo "no web UI"
        ;;
      *)
        printf "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\n\r\nnot found\n"
        ;;
    esac
  '
fi

echo "lca-web: need python3 or nc; install one." >&2
exit 1
